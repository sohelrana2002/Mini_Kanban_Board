{
  "name": "kanban-backend",
  "version": "1.0.0",
  "main": "server.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "start": "node dist/server.js"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "tsx src/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^20.0.0",
    "prisma": "^8.0.0-rc.13",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0"
  }
}
